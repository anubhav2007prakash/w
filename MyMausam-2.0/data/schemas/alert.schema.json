{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeatherAlert",
  "type": "object",
  "properties": {
    "id": {"type": "integer"},
    "location_name": {"type": "string"},
    "alert_type": {"type": "string"},
    "severity": {"type": "string", "enum": ["green", "yellow", "orange", "red"]},
    "description": {"type": "string"}
  },
  "required": ["location_name", "alert_type", "severity", "description"]
}
