rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /weather_telemetry/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /crowd_reports/{reportId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.reporter_name != null;
      allow update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
